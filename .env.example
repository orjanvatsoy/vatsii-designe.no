# Runtime: Supabase transaction pooler (port 6543) for serverless functions.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?sslmode=require"
# Migrations: Supabase session pooler (port 5432) or direct connection.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require"
# Development only: render local product examples without DATABASE_URL.
USE_MOCK_DATA="false"
# Development only: render local customer request examples without login.
NEXT_PUBLIC_USE_MOCK_DATA="false"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
RESEND_API_KEY="re_..."
