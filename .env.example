# Runtime: Supabase transaction pooler (port 6543) for serverless functions.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?sslmode=require"
# Migrations: Supabase session pooler (port 5432) or direct connection.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require"
# Development only: render local product examples without DATABASE_URL.
USE_MOCK_DATA="false"
# Development only: render local customer request examples without login.
NEXT_PUBLIC_USE_MOCK_DATA="false"
# Development only: use a synthetic King session on localhost.
NEXT_PUBLIC_LOCAL_AUTH_BYPASS="false"
# Optional real auth user UUID for local admin mutations that record a user ID.
LOCAL_AUTH_USER_ID="00000000-0000-0000-0000-000000000000"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
RESEND_API_KEY="re_..."
ORDER_NOTIFICATION_EMAIL="din-epost@eksempel.no"
ORDER_EMAIL_FROM="Vatsii Designe <foresporsel@ditt-verifiserte-domene.no>"
# Optional contact-specific overrides. Falls back to the order email values.
CONTACT_EMAIL_TO="din-epost@eksempel.no"
CONTACT_EMAIL_FROM="Vatsii Designe <kontakt@ditt-verifiserte-domene.no>"