generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id   String  @id @db.Uuid
  role String?

  @@map("profiles")
}

model CarouselImage {
  id          BigInt   @id @default(autoincrement())
  imageUrl    String   @map("image_url")
  title       String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("carousel_images")
}

model Product {
  id          BigInt   @id @default(autoincrement())
  name        String
  description String
  category    String
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)

  @@map("products")
}

model TemperatureData {
  id                  BigInt   @id @default(autoincrement())
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  temperature         Float
  temperatureForecast Float?   @map("temperature_forcast")

  @@map("temperature_data")
}