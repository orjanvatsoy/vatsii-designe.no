generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id   String  @id @db.Uuid
  role String?

  @@map("profiles")
}

model CarouselImage {
  id          String   @id @default(uuid()) @db.Uuid
  imageUrl    String   @map("image_url")
  title       String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("carousel_images")
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  description     String
  category        String
  inquiryInputMode String          @default("comment") @map("inquiry_input_mode")
  imageUrl        String?          @map("image_url")
  imagePositionX  Int              @default(50) @map("image_position_x")
  imagePositionY  Int              @default(50) @map("image_position_y")
  imageRotation   Int              @default(0) @map("image_rotation")
  imageZoom       Int              @default(100) @map("image_zoom")
  active          Boolean          @default(true)
  placeCardOrders PlaceCardOrder[]

  @@map("products")
}

model PlaceCardOrder {
  id               BigInt    @id @default(autoincrement())
  userId           String?   @map("user_id") @db.Uuid
  customerEmail    String    @map("customer_email")
  customerName     String?   @map("customer_name")
  productId        String    @map("product_id") @db.Uuid
  inputMode        String    @default("name_list") @map("input_mode")
  names            String    @db.Text
  quantity         Int
  customDimensions String?   @map("custom_dimensions") @db.Text
  customBudget      Int?      @map("custom_budget")
  desiredDeliveryDate DateTime? @map("desired_delivery_date") @db.Date
  status           String    @default("new")
  estimatedPrice   Int?      @map("estimated_price")
  deliveryEstimate String?   @map("delivery_estimate")
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(6)
  cancellationReason String? @map("cancellation_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  customerUpdatedAt DateTime? @map("customer_updated_at") @db.Timestamptz(6)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  attachments      InquiryAttachment[]
  messages         OrderMessage[]

  @@index([userId])
  @@index([customerEmail])
  @@index([productId])
  @@map("place_card_orders")
}

model InquiryAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     BigInt   @map("order_id")
  objectKey   String   @map("object_key")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order       PlaceCardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("inquiry_attachments")
}

model OrderMessage {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        BigInt    @map("order_id")
  senderRole     String    @map("sender_role")
  senderUserId   String    @map("sender_user_id") @db.Uuid
  body           String    @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  customerReadAt DateTime? @map("customer_read_at") @db.Timestamptz(6)
  adminReadAt    DateTime? @map("admin_read_at") @db.Timestamptz(6)
  order          PlaceCardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_messages")
}

model TemperatureData {
  id                  BigInt   @id @default(autoincrement())
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  temperature         Float
  temperatureForecast Float?   @map("temperature_forcast")

  @@map("temperature_data")
}
