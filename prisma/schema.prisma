generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id   String  @id @db.Uuid
  role String?

  @@map("profiles")
}

model CarouselImage {
  id          String   @id @default(uuid()) @db.Uuid
  imageUrl    String   @map("image_url")
  title       String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("carousel_images")
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  description     String
  category        String
  inquiryInputMode String          @default("comment") @map("inquiry_input_mode")
  imageUrl        String?          @map("image_url")
  active          Boolean          @default(true)
  placeCardOrders PlaceCardOrder[]

  @@map("products")
}

model PlaceCardOrder {
  id               BigInt    @id @default(autoincrement())
  userId           String?   @map("user_id") @db.Uuid
  customerEmail    String    @map("customer_email")
  customerName     String?   @map("customer_name")
  productId        String    @map("product_id") @db.Uuid
  inputMode        String    @default("name_list") @map("input_mode")
  names            String    @db.Text
  quantity         Int
  status           String    @default("new")
  estimatedPrice   Int?      @map("estimated_price")
  deliveryEstimate String?   @map("delivery_estimate")
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(6)
  cancellationReason String? @map("cancellation_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  customerUpdatedAt DateTime? @map("customer_updated_at") @db.Timestamptz(6)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([customerEmail])
  @@index([productId])
  @@map("place_card_orders")
}

model TemperatureData {
  id                  BigInt   @id @default(autoincrement())
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  temperature         Float
  temperatureForecast Float?   @map("temperature_forcast")

  @@map("temperature_data")
}
